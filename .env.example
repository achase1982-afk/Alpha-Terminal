# Dedicated web search (Tavily-compatible POST /search). When WEB_SEARCH_API_KEY is set,
# chat, strategist, debate, desk, and catalyst searches use this API instead of provider-native search.
WEB_SEARCH_API_KEY=
# WEB_SEARCH_API_BASE_URL=https://api.tavily.com/search
# WEB_SEARCH_API_FALLBACK_KEY=
# WEB_SEARCH_API_FALLBACK_BASE_URL=
# WEB_SEARCH_API_MAX_RESULTS=8
# WEB_SEARCH_API_TIMEOUT_MS=20000

GEMINI_API_KEY=
# pragma: allowlist secret
# Strategist / models (chat, etc.). Desk audio TTS does not use OpenAI Speech.
OPENAI_API_KEY=
# Optional: Replit-style OpenAI proxy (see aiLabAnalystClient)
# AI_INTEGRATIONS_OPENAI_API_KEY=
# AI_INTEGRATIONS_OPENAI_BASE_URL=
# Desk TTS uses Edge neural speech (node-edge-tts). Optional tuning:
# EDGE_TTS_VOICE=
# EDGE_TTS_LANG=
# EDGE_TTS_TIMEOUT_MS=
# Optional disk cache for desk TTS MP3 files (default /tmp/tts-cache)
# TTS_CACHE_DIR=
