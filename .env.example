GEMINI_API_KEY=
# pragma: allowlist secret
# Desk TTS (OpenAI Speech API): use same key pattern as Strategist OpenAI paths.
OPENAI_API_KEY=
# Optional: Replit-style OpenAI proxy (see aiLabAnalystClient)
# AI_INTEGRATIONS_OPENAI_API_KEY=
# AI_INTEGRATIONS_OPENAI_BASE_URL=
# Desk TTS backend: openai | edge | omit for auto (OpenAI if speech keys exist, else Edge).
# Set edge to avoid OpenAI Speech billing while keeping OPENAI_API_KEY for other APIs.
# TTS_PROVIDER=edge
# Optional Edge tuning when using TTS_PROVIDER=edge (defaults: en-US-AriaNeural / en-US)
# EDGE_TTS_VOICE=
# EDGE_TTS_LANG=
# EDGE_TTS_TIMEOUT_MS=
# Optional: override OpenAI TTS model / voice (defaults: gpt-4o-mini-tts, alloy)
# OPENAI_TTS_MODEL=
# OPENAI_TTS_VOICE=
# Optional disk cache for desk TTS MP3 files (default /tmp/tts-cache)
# TTS_CACHE_DIR=
