{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && node ./scripts/free-port.mjs 8080 && pnpm run build && pnpm run start",
    "build": "pnpm run typecheck && node ./build.mjs",
    "migrate:deploy": "node ./scripts/migrate-deploy.mjs",
    "start": "pnpm run migrate:deploy && node --enable-source-maps --max-http-header-size=65536 ./dist/index.mjs",
    "pretypecheck": "pnpm exec tsc --build --force ../../lib/ai-models ../../lib/chat-types ../../lib/db ../../lib/api-zod ../../lib/integrations-gemini-ai ../../lib/movers-types ../../lib/catalysts-types ../../lib/strategist-card-bullets",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "tuning:backfill": "tsx src/jobs/tuningUniverseBackfill.ts",
    "tuning:backfill:options": "tsx src/jobs/runTuningOptionsBackfillOnly.ts",
    "catalyst:harvest": "tsx src/jobs/runCatalystEarningsHarvest.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.66",
    "@ai-sdk/google": "^3.0.64",
    "@ai-sdk/openai": "^3.0.53",
    "@ai-sdk/xai": "^3.0.83",
    "@anthropic-ai/sdk": "^0.88.0",
    "@aws-sdk/client-s3": "^3.1027.0",
    "@aws-sdk/lib-storage": "^3.1027.0",
    "@clerk/express": "^2.0.7",
    "@google/genai": "^1.50.1",
    "@mozilla/readability": "^0.6.0",
    "@opentelemetry/api": "^1.9.1",
    "@stoqey/ib": "^1.5.3",
    "@workspace/ai-models": "workspace:*",
    "@workspace/api-zod": "workspace:*",
    "@workspace/catalysts-types": "workspace:*",
    "@workspace/chat-types": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/integrations-gemini-ai": "workspace:*",
    "@workspace/movers-types": "workspace:*",
    "@workspace/strategist-card-bullets": "workspace:*",
    "ai": "^6.0.138",
    "better-sqlite3": "^12.11.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2",
    "dotenv": "^16.6.1",
    "drizzle-orm": "catalog:",
    "express": "^5",
    "linkedom": "^0.18.12",
    "node-edge-tts": "^1.2.10",
    "openai": "^6.34.0",
    "p-limit": "^7.3.0",
    "pg": "^8.20.0",
    "pino": "^9",
    "pino-http": "^10",
    "technicalindicators": "^3.1.0",
    "web-push": "^3.6.7",
    "ws": "^8.20.0",
    "yaml": "^2.9.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/supertest": "^7.2.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13",
    "supertest": "^7.2.2",
    "thread-stream": "3.1.0",
    "tsx": "catalog:",
    "vitest": "^2.1.9"
  }
}
