server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Compress text assets to keep transfer sizes reasonable.
    gzip on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript image/svg+xml;

    # Long-cache hashed Vite assets; index.html stays short-cache so deploys
    # are picked up immediately by returning visitors.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    location = /index.html {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        try_files $uri =404;
    }

    # Proxy API calls to the backend service over Railway's internal network.
    # API_BACKEND should be set without a trailing slash, e.g.
    #   http://api-server.railway.internal:8080
    #
    # DNS_RESOLVER is the container's nameserver (from /etc/resolv.conf),
    # injected by docker-entrypoint.sh. Setting it here lets nginx re-resolve
    # Railway's internal hostname after backend redeploys instead of pinning
    # a stale IP from startup.
    resolver ${DNS_RESOLVER} valid=10s ipv6=off;

    location /api/ {
        # Use an nginx variable so the resolver directive above is honoured
        # and the hostname is re-resolved periodically (not just at startup).
        set $api_backend ${API_BACKEND};
        proxy_pass $api_backend;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Streaming-friendly: SSE / long-polling / websockets pass through cleanly.
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # SPA fallback — every non-asset, non-api route returns index.html so
    # client-side routing (wouter) can take over.
    location / {
        try_files $uri $uri/ /index.html;
    }
}

# Map block for the websocket Connection header used above.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}
